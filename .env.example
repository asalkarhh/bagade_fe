# Backend URL proxied for /api during local Vite dev/preview (defaults to http://localhost:8080)
VITE_API_PROXY_TARGET=http://localhost:8080

# Optional API path prefix override (defaults to /api/v1)
# VITE_API_BASE_URL=/api/v1

# Shop IANA timezone used for default order/received dates (defaults to Asia/Kolkata)
# VITE_SHOP_TIMEZONE=Asia/Kolkata

# Default product tag print profile (50x30, 50x25, or 38x25; defaults to 50x30)
# VITE_LABEL_PROFILE=50x30
